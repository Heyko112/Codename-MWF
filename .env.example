# Kopieren nach .env und Passwörter ändern (nur Buchstaben, Ziffern, - und _; kein $).
APP_PORT=8080
# 127.0.0.1 = nur dieser Rechner (Standard), 0.0.0.0 = ganzes Netzwerk
APP_BIND=127.0.0.1

DB_NAME=mwf
DB_USER=mwf
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern-root

# Session-Cookie nur über HTTPS (ab Schritt 6 auf true)
COOKIE_SECURE=false

# Schlüssel für die TOTP-Secrets in der DB. Einmal erzeugen und nie wieder ändern,
# sonst funktioniert die 2FA aller Benutzer nicht mehr:  openssl rand -base64 32
TOTP_KEY=
